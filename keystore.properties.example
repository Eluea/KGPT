# KGPT signing credentials template
# Copy this file to "keystore.properties" in the repo root and fill in real
# values. keystore.properties is gitignored — NEVER commit it.
#
# storeFile may be absolute or relative to the app/ module directory.
#
# Alternatively, provide credentials via environment variables:
#   KGPT_STORE_FILE, KGPT_STORE_PASSWORD, KGPT_KEY_ALIAS, KGPT_KEY_PASSWORD

storeFile=keystore/kgpt_release.jks
storePassword=CHANGE_ME
keyAlias=kgpt
keyPassword=CHANGE_ME
