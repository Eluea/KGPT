<!--
   Android 12+ backup & device-transfer rules.
   The "keyboard_gpt" prefs hold AI provider API keys — excluded from cloud
   backup and device-to-device transfer so they never leave the device.
   In-app backups are handled by BackupManager (Google Drive).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="keyboard_gpt.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="keyboard_gpt.xml" />
    </device-transfer>
</data-extraction-rules>
