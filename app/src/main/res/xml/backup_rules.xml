<!--
   Android 11 and below auto-backup rules.
   The "keyboard_gpt" prefs hold AI provider API keys — they must never leave
   the device via cloud/device-to-device backup. In-app backups are handled by
   BackupManager (Google Drive) which encrypts/handles credentials separately.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="keyboard_gpt.xml" />
</full-backup-content>
